# ──────────────────────────────────────────────
# LLM 제공자 선택: "openai" 또는 "claude"
# ──────────────────────────────────────────────
LLM_PROVIDER=openai

# OpenAI API 키 (LLM_PROVIDER=openai 시 필요)
# 발급: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Anthropic Claude API 키 (LLM_PROVIDER=claude 시 필요)
# 발급: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ──────────────────────────────────────────────
# LMS (e-루리) 계정 — 선택사항
# 입력 시 과제/퀴즈 마감 정보를 추가로 수집합니다.
# ──────────────────────────────────────────────
LMS_USERNAME=
LMS_PASSWORD=

# ──────────────────────────────────────────────
# 에브리타임 계정 — 선택사항
# 입력 시 시험정보/강의평가 게시판 정보를 수집합니다.
# ──────────────────────────────────────────────
EVERYTIME_USERNAME=
EVERYTIME_PASSWORD=

# ──────────────────────────────────────────────
# 서버 설정 (기본값 사용 시 수정 불필요)
# ──────────────────────────────────────────────
HOST=localhost
PORT=8000
